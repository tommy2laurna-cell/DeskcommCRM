# =============================================================================
# PERFIL CONECTADO — .env del cliente (solo lo que se completa por cliente)
# =============================================================================
# Uso: copiar a la raíz de la instalación como `.env`, completar los campos
# marcados [POR CLIENTE] y correr `bash hostgator-setup-kit/install.sh`.
# El instalador salta las preguntas que ya tienen valor y pregunta el resto.
#
# NO agregar acá secretos (INTERNAL_SECRET, CPF_ENCRYPTION_KEY, AI_CRED_AES_KEY,
# WAHA_*, UPSTASH_*, etc.): los genera install.sh. Las URLs de WAHA y Redis
# también las escribe él.
#
# Este archivo NO se commitea ni se entrega. Las claves reales viven fuera de
# OneDrive y se entregan por canal seguro (ver ENTREGA.md).
# =============================================================================

# --- Dominio ------------------------------------------------------------------
# [POR CLIENTE] Solo el dominio, sin https:// ni barra. Con registro A apuntando
# a la IP de la VPS ANTES de instalar (si no, el cadenado no sale).
DOMAIN=
# [POR CLIENTE] Mail al que Let's Encrypt avisa vencimientos del certificado.
ACME_EMAIL=

# --- Supabase del cliente -------------------------------------------------------
# [POR CLIENTE] Settings > API del proyecto Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# [POR CLIENTE] Settings > Database > Connection string, "Session pooler", modo
# URI. Nunca la "Direct connection" (es solo IPv6 y no conecta desde una VPS).
SUPABASE_DB_URL=
# SUPABASE_ACCESS_TOKEN no va acá: el instalador NO lo guarda en el .env.
# Exportarlo en la terminal antes de correr install.sh (ver CHECKLIST).

# --- Primer administrador -------------------------------------------------------
# [POR CLIENTE] Mail y contraseña (mínimo 8 caracteres) del dueño en el CRM.
OWNER_EMAIL=
OWNER_PASSWORD=

# --- Marca del cliente (white-label) --------------------------------------------
# [POR CLIENTE] Nombre que se ve en la interfaz. Si queda vacío el instalador
# propone "DeskcommCRM": NO aceptarlo, va el nombre del cliente.
APP_NAME=
# Idioma del sistema: pt-BR o es (el instalador también acepta 1 o 2).
APP_LOCALE=es
# [POR CLIENTE] Color en #RRGGBB (# y 6 dígitos hex). Otro formato se descarta.
APP_ACCENT_HEX=
# Logo: se sube por pantalla (Configuraciones > Marca) como PNG o JPG de hasta
# 512 KB; SVG no se acepta. Dejar vacío salvo que ya exista una URL pública.
APP_LOGO_URL=

# --- Mails ----------------------------------------------------------------------
# [POR CLIENTE] Mail de soporte que ven los clientes del cliente. Vacío = la
# pantalla de cuenta suspendida no muestra contacto.
SUPPORT_EMAIL=
# [POR CLIENTE] Resend: clave y remitente de un dominio YA verificado en Resend.
# Si no hay dominio verificado, dejar las dos vacías: las invitaciones se pasan
# con "Copiar link" y los mails de acceso salen por el SMTP de Supabase (con
# límite bajo por hora).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- IA (perfil conectado) --------------------------------------------------------
# [POR CLIENTE] Completar la clave del proveedor que el instalador pregunta
# (una sola de las tres). Si queda vacía se carga después en IA > Credenciales.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Clave de OpenAI: transcripción de audios y base de conocimiento.
OPENAI_API_KEY=

# --- Decisiones fijas de LRN (no cambian por cliente) ---------------------------
# Solo por invitación. El valor por defecto del producto es `aberto` (cualquiera
# puede crear cuenta en el dominio del cliente).
SIGNUP_MODE=so_convite
# Sin telemetría al Sentry del upstream. Si queda sin definir, el instalador
# pregunta y el cliente podría aceptar sin entender a quién se envía.
SENTRY_DSN=off
