# Agregar al .env del VPS (nunca al repo). Las credenciales viven SOLO ahí.
CLIENTE_NOMBRE="Nombre del cliente"
ALERTA_EMAIL=tomas@ejemplo.com            # a quién avisa salud.sh
# Backup: clave de cifrado (guardala TAMBIÉN en el gestor de claves de LRN: sin ella el backup no se abre)
BACKUP_PASSPHRASE=
BACKUP_REMOTE=gdrive:deskcomm-backups     # remote de rclone (carpeta en el Drive del cliente, por D6)
# rclone sin rclone.conf: remote "gdrive" definido por entorno
RCLONE_CONFIG_GDRIVE_TYPE=drive
RCLONE_CONFIG_GDRIVE_SCOPE=drive.file
RCLONE_CONFIG_GDRIVE_TOKEN=               # JSON del token (rclone authorize "drive")
# Mail de alertas: se usa RESEND_API_KEY + RESEND_FROM_EMAIL del cliente si están; si no, SMTP:
#SMTP_URL=smtps://smtp.ejemplo.com:465
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=alertas@ejemplo.com
